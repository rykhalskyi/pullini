# Copy to .env and adjust. All values are optional for local development.

# Django
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Production only: with DJANGO_DEBUG=false the secret must be a unique value of
# at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The placeholder below is only accepted while DJANGO_DEBUG=true.
DJANGO_SECRET_KEY=insecure-development-key-change-me

# Set to false only when TLS is terminated by a trusted proxy that you control.
DJANGO_SECURE_COOKIES=true

# TLS / reverse proxy (production only). Enable these only when a proxy that you
# control terminates TLS and strips/sets X-Forwarded-Proto. Otherwise clients
# could spoof HTTPS and redirect loops can occur.
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_SECURE_SSL_REDIRECT=false
# Seconds; e.g. 31536000 for one year. 0 disables HSTS.
DJANGO_SECURE_HSTS_SECONDS=0

# Persistence. Everything mutable lives under this directory.
DATA_DIR=./data

# Docker Compose only: host port to publish the web container on (default 8000).
PULLINI_PORT=8000

# Database. Leave unset for SQLite (default). Example PostgreSQL DSN:
# DATABASE_URL=postgres://pullini:pullini@localhost:5432/pullini
