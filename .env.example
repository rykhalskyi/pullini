# Copy to .env and adjust. All values are optional for local development.

# Django
DJANGO_SECRET_KEY=insecure-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Set to false only when TLS is terminated by a trusted proxy that you control.
DJANGO_SECURE_COOKIES=true

# Persistence. Everything mutable lives under this directory.
DATA_DIR=./data

# Database. Leave unset for SQLite (default). Example PostgreSQL DSN:
# DATABASE_URL=postgres://pullini:pullini@localhost:5432/pullini
